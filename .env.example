# Copia este archivo como .env y ajusta tus datos locales de MySQL Workbench
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ortochika
USE_SQLITE=true

# Cuenta de administrador (se crea con: flask --app run crear-admin).
# Valores de ejemplo solo para desarrollo local: cámbialos, sobre todo antes de desplegar.
ADMIN_EMAIL=admin@ortochika.com
ADMIN_PASSWORD=Admin2026!
